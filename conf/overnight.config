// ===========================================================================
// conf/overnight.config -- settings for an UNATTENDED run
//
//   nextflow run . -profile cardinal,vcf2maf_host \
//       -params-file params/cardinal_test.yaml \
//       -c conf/overnight.config --run_pcgr_gapfill true -resume
//
// WHY THIS FILE EXISTS
// --------------------
// The default error strategy is `terminate`: the first failed task stops the
// whole run. That is right when you are watching -- you see the error in
// seconds and fix it. It is wrong overnight, because one bad patient at 02:00
// wastes the remaining six hours and you wake up to nothing.
//
// So: retry once on the transient failures, then keep going, and make the
// survivors reportable. This is NOT error suppression -- every failure is
// recorded, counted, and named in the completion summary below. The run
// finishes with a non-zero task count you must look at.
// ===========================================================================

process {
    // Keep task directories readable when something fails.
    //
    // The cardinal profile sets scratch = true, which runs each task in a
    // node-local temp dir. Nextflow copies outputs back ONLY on success and
    // then deletes the scratch dir, so a FAILED task leaves no log, no partial
    // output, and an empty .command.err. Debugging an unattended run is then
    // impossible: you wake up to failures with no evidence.
    scratch = false

    // Retry once, then continue. maxErrors caps the damage: if a THIRD of the
    // cohort fails there is something systematically wrong and continuing just
    // produces a confident-looking figure built on a third of the data.
    errorStrategy = { task.exitStatus in [126,127] ? 'terminate'
                        : (task.attempt <= 2 ? 'retry' : 'ignore') }
    maxRetries    = 2
    maxErrors     = 8

    // NEVER retry a deterministic failure.
    //
    // 126 = found but not executable, 127 = command not found. Neither is
    // transient: the second attempt fails identically, and so does the tenth.
    // The first gap-fill attempt spent the night retrying exit 127 on every
    // patient (pcgr was not on PATH inside the container) and produced nothing
    // except load on the scheduler. Fail those immediately and loudly.
    //
    // Retry is for the genuinely transient: OOM (137), walltime (140/143), node
    // failure (247). Those escalate resources via `* task.attempt` in
    // conf/base.config, so a second attempt is meaningfully different.
    withName: RUN_PCGR {
        errorStrategy = {
            // 134 = SIGABRT. A crashed interpreter is as deterministic as a
            // missing command: 7 retries of an aborting PCGR cost half an hour
            // of scheduler time and produced seven identical core dumps.
            if (task.exitStatus in [126, 127, 134]) return 'terminate'
            if (task.exitStatus in [130, 137, 140, 143, 247] && task.attempt <= 3) return 'retry'
            return task.attempt <= 2 ? 'retry' : 'ignore'
        }
        maxRetries    = 3
    }

    // INGEST MUST NEVER BE IGNORED.
    //
    // Everything downstream reads the manifest. If BUILD_MANIFEST fails and is
    // ignored, no other process has input, the run ends in seconds having done
    // nothing, and workflow.success is TRUE -- so the summary below prints
    // "status: completed" over an empty result. That happened: 0 tasks ok,
    // BUILD_MANIFEST ignored after 2 retries, reported as a successful run.
    //
    // A failure that produces no output must stop the run, not be tolerated by
    // it. `ignore` is only ever appropriate for a process whose absence costs
    // one patient or one figure.
    withName: 'BUILD_MANIFEST|MERGE_METADATA|BUILD_COHORT_SEG' {
        errorStrategy = 'terminate'
    }

    // The analyses at the end must NOT be ignored. If the oncoplot fails there
    // is no point having a report, and a silently absent figure is exactly the
    // failure mode this pipeline exists to prevent.
    withName: 'ONCOPRINT|CNV_FREQUENCY|CNV_BURDEN|EXPRESSION_PCA|RECURRENT_FUSIONS|COHORT_REPORT' {
        errorStrategy = 'terminate'
    }
}

// Keep the scheduler busy but inside a courteous share of the partition.
executor {
    queueSize       = 20
    submitRateLimit = '10/1min'
}

// Machine-readable record of what happened, for the morning.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/_run/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/_run/report.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/_run/trace.txt"
           fields  = 'task_id,name,status,exit,attempt,realtime,%cpu,peak_rss,workdir' }

workflow.onComplete = {
    def line = "=" * 70

    // workflow.success is TRUE when every task either succeeded or was
    // IGNORED. A run where nothing succeeded and everything was ignored is
    // therefore reported as a success -- which is how a 22-second run with 0
    // completed tasks printed "status: completed". Judge on the counts, not
    // on the flag alone.
    def ok      = workflow.stats.succeedCount
    def ignored = workflow.stats.ignoredCount
    def verdict = !workflow.success ? 'FAILED'
                : ok == 0           ? 'FAILED (nothing ran)'
                : ignored > 0       ? "completed WITH ${ignored} IGNORED FAILURE(S)"
                :                     'completed'
    println """
${line}
OVERNIGHT RUN FINISHED
${line}
  status        : ${verdict}
  duration      : ${workflow.duration}
  tasks ok      : ${workflow.stats.succeedCount}
  tasks failed  : ${workflow.stats.failedCount}
  tasks ignored : ${workflow.stats.ignoredCount}

  READ THIS FIRST IN THE MORNING:
    ${params.outdir}/_provenance/mutation_provenance.tsv
        -- which mutation source each patient ended up using. Patients whose
           PCGR gap-fill failed are ABSENT from it, not marked; compare the row
           count against the manifest.

    ${params.outdir}/_run/report.html      -- per-task resources and exit codes
    ${params.outdir}/_run/trace.txt        -- grep for status FAILED / ABORTED

  If tasks were ignored, the cohort figures were built on FEWER patients than
  the manifest lists. Check the n in each figure title before using anything.
${line}
"""
}
