// ===========================================================================
// conf/base.config -- resource allocation by process label
//
// The original config gave EVERY process the same 4h / 32 GB. On a SLURM
// cluster that means trivial tasks queue behind large allocations while the
// genuinely heavy ones (loading dozens of PCGR MAFs, building a 60k-gene
// expression matrix) still get killed.
//
// Resources scale on retry, so a task that hits OOM is resubmitted with more
// memory instead of failing the run. This matters most for ONCOPRINT and
// EXPRESSION_PCA, whose footprint depends on cohort size.
// ===========================================================================

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) }
        catch (all) { return obj }
    }
}

process {

    cpus   = { check_max(1    * task.attempt, 'cpus'  ) }
    memory = { check_max(6.GB * task.attempt, 'memory') }
    time   = { check_max(2.h  * task.attempt, 'time'  ) }

    // 137/139/140 = OOM-killed or wall-clock kill -> retry with more.
    // 130/143     = interrupted/cancelled        -> retry.
    errorStrategy = { task.exitStatus in [104,130,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { check_max(1,                  'cpus'  ) }
        memory = { check_max(4.GB * task.attempt, 'memory') }
        time   = { check_max(1.h  * task.attempt, 'time'  ) }
    }

    withLabel: process_low {
        cpus   = { check_max(2    * task.attempt, 'cpus'  ) }
        memory = { check_max(8.GB * task.attempt, 'memory') }
        time   = { check_max(2.h  * task.attempt, 'time'  ) }
    }

    withLabel: process_medium {
        cpus   = { check_max(4     * task.attempt, 'cpus'  ) }
        memory = { check_max(24.GB * task.attempt, 'memory') }
        time   = { check_max(6.h   * task.attempt, 'time'  ) }
    }

    withLabel: process_high_memory {
        // ONCOPRINT and EXPRESSION_PCA. PCGR MAFs run to tens of MB each and
        // maftools holds the whole cohort in memory; the expression matrix is
        // n_patients x ~60k genes before variable-gene filtering.
        cpus   = { check_max(4     * task.attempt, 'cpus'  ) }
        memory = { check_max(48.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time'  ) }
    }

    // VEP inside vcf2maf: the dominant cost of the whole pipeline. It forks
    // across task.cpus, and its cache access is I/O heavy. At 4,500 patients
    // this is the one label worth tuning to your cluster.
    withLabel: process_vep {
        cpus   = { check_max(4,                    'cpus'  ) }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(6.h   * task.attempt, 'time'  ) }
    }

    // PCGR gap-fill. These match what GenPipes actually requested for the
    // delivered runs (cluster_mem = 36G, cluster_walltime = 3:00:0,
    // cluster_cpu = HALF_CPU), with headroom on retry rather than guesses.
    withLabel: process_pcgr {
        cpus   = { check_max(4,                    'cpus'  ) }
        memory = { check_max(36.GB * task.attempt, 'memory') }
        time   = { check_max(4.h   * task.attempt, 'time'  ) }
    }

    // GISTIC via the MATLAB Compiler Runtime is single-threaded and slow.
    withName: GISTIC {
        cpus   = { check_max(1,                    'cpus'  ) }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time'  ) }
    }

    // Manifest building is pure filesystem traversal: cheap, but on a parallel
    // filesystem with hundreds of thousands of files it can be slow, so give
    // it room on the clock rather than the RAM.
    withName: BUILD_MANIFEST {
        cpus   = 1
        memory = { check_max(4.GB, 'memory') }
        time   = { check_max(2.h * task.attempt, 'time') }
    }
}
