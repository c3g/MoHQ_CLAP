// ===========================================================================
// nextflow.config
//
// Key changes from the original:
//   * `containerEngine = 'apptainer'` was set as a PROCESS directive. That is
//     not a valid process directive and was silently ignored; the apptainer
//     scope below is what actually enables it.
//   * Resources now come from per-process labels (conf/base.config) with
//     retry-on-OOM escalation, instead of every task inheriting 4h / 32 GB.
//   * The SLURM account is a parameter, not a hardcoded string.
//   * Profiles separate cluster config from pipeline logic.
//   * All params used anywhere are declared here, so a typo in a YAML is
//     visible rather than silently becoming `null`.
// ===========================================================================

manifest {
    name            = 'mohq-cohort'
    author          = 'Mariyana Slavova'
    description     = 'Cohort-scale analysis for MoHQ cancer genomics deliveries'
    version         = '2.0.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
}

params {
    // --- Input ------------------------------------------------------------ //
    input           = null      // samplesheet CSV: cohort_id,cohort_dir
    cohort_dir      = null      // single-cohort mode
    cohort_name     = null
    outdir          = './results'

    // Optional clinical metadata joined onto the manifest (sex, tumour type,
    // stage, outcome...). Must contain a patient-ID column.
    extra_metadata  = null

    // --- Collection tier (all ~65 cohorts) -------------------------------- //
    collection_name = 'MoHQ'
    run_collection  = false   // all-cohorts rollup; leave off until one cohort works

    // TSV: cohort_id, cancer_type [, accrual_year, sequencing_platform].
    // REQUIRED for the batch-effect analysis. Because the same cancer type is
    // sequenced at several institutions, holding cancer type constant isolates
    // the technical effect -- but only if we know which cohorts share a type.
    cohort_map          = null
    batch_min_per_cell  = 5      // min patients per (cancer_type, institution) cell

    // --- Scale ------------------------------------------------------------- //
    // Manifest cache: unchanged patients are detected by subdirectory mtime and
    // skipped without reading their directories. Delete the file to force a
    // full rescan. Measured 12x faster on a warm cache locally; the gain is
    // larger on Lustre, where the saving is network round trips.
    manifest_cache_dir  = "${projectDir}/.manifest_cache"
    use_manifest_cache  = true

    // Above this many patients the completeness heatmap aggregates to cohort
    // level; one tile row per patient is unreadable past ~150 and unrenderable
    // at 4,500.
    completeness_max_tile_rows = 150
    // Assets absent for EVERY patient are a harvest-scope choice far more often
    // than a delivery gap. Kept out of the tiles and listed in a table instead;
    // set false to plot the full expected asset list.
    completeness_drop_never_present = true

    // --- References ------------------------------------------------------- //
    gtf             = null      // GRCh38 GTF or 4-col BED. REQUIRED for --run_comparative.
    refgene         = null      // GISTIC .mat reference. REQUIRED for --run_gistic.

    // --- vcf2maf / VEP ---------------------------------------------------- //
    // REQUIRED. The MAFs distributed in the MoHQ collection are not gene
    // annotated (Hugo_Symbol = "Unknown"), so every mutation analysis runs on
    // MAFs regenerated here from the PCGR VCFs.
    vcf2maf_path    = null      // path to vcf2maf.pl  (ALWAYS required)

    // PCGR runs VEP itself, so its VCFs already carry a CSQ annotation field.
    // With inhibit_vep = true, vcf2maf parses that instead of re-running VEP:
    // no VEP cache needed, seconds instead of minutes per patient, and the MAFs
    // agree with the PCGR reports rather than being a second opinion.
    // Check first:  zcat <pcgr_vcf> | grep -m1 '^##INFO=<ID=CSQ'
    inhibit_vep     = true

    // Only needed when inhibit_vep = false.
    vep_cache       = null
    ref_fasta       = null
    vep_path        = null      // leave null when running inside vep_container
    // Kept only so an old params file setting it fails loudly rather than
    // silently. Current vcf2maf has no --filter-vcf option at all: it was
    // removed along with ExAC support. Leave this null.
    vcf2maf_filter_vcf = null

    // Path to a samtools binary VISIBLE INSIDE the VEP container. vcf2maf calls
    // `samtools faidx` for reference alleles, and the Ensembl VEP image has no
    // samtools binary (VEP uses Bio::DB::HTS instead). Leave null only if
    // samtools is already on PATH in whatever container VCF2MAF runs in.
    samtools_exec = null
    tabix_exec    = null   // likewise; vcf2maf hard-requires tabix too

    // Post-vcf2maf sanity checks. Tuned for WHOLE-GENOME somatic calls, where a
    // majority of variants are legitimately intergenic and therefore Unknown.
    // Failed annotation shows up as ~0 distinct genes, not as a high fraction.
    min_annotated_genes = 200     // WGS typically gives several thousand
    max_unknown_frac    = 0.95    // only reachable if annotation truly failed
    // These two are read by BOTH the VCF2MAF shell guard and
    // load_somatic_mafs() in bin/mohq_common.R (via the env block below).
    // They were once separate hardcoded 50% thresholds and both were wrong for
    // whole-genome data -- one source of truth now.
    genome_build    = 'GRCh38'

    // VEP image for the VCF2MAF step. Separate from the analysis container:
    // pipeline.sif has R, this one has perl + vep. Built by bin/setup_vep.sh.
    //
    // The cache version MUST match the VEP release in this image, or you get
    // either a hard failure or, worse, quietly inconsistent annotation.
    vep_container     = null
    vep_cache_version = '115'

    // Persistent home for converted MAFs. VEP is the most expensive step in the
    // pipeline; keeping its output outside the work directory means it is not
    // recomputed when work/ is cleaned or the pipeline is upgraded.
    derived_maf_dir = "${projectDir}/derived_mafs"

    // --- Regenerating missing PCGR VCFs ----------------------------------- //
    // Some patients never received a PCGR VCF (produced, then deleted). Rather
    // than falling back to their ensemble VCF -- which is a different variant
    // set and would bias TMB -- we re-run PCGR so every patient follows the
    // same path.
    //
    // Use the SAME version the delivered patients used. Check with:
    //     bash bin/check_tool_versions.sh HM/MoHQ-HM-19 --cohort 10
    run_pcgr_gapfill    = false

    // Regenerate the PCGR VCF for EVERY patient, including those whose
    // delivered one is present.
    //
    // Default false: never re-derive data that already exists. But a cohort
    // where some patients use the delivered VCF and others a regenerated one
    // carries provenance as a hidden covariate, and in cohorts like MoHQ-MU-16
    // there are THREE sources at once (in-patient delivered, a separately
    // delivered batch directory, and regenerated). Setting this true puts every
    // patient through one identical path, so provenance stops varying.
    //
    // Only defensible once regeneration has been shown to REPRODUCE the
    // delivered file for that cohort -- verified for MoHQ-HM-19, where the
    // reconstruction gave 23,604 variants against the delivered 23,604. Repeat
    // that check per cohort before turning this on; PCGR version and GenPipes
    // vintage differ between cohorts.
    //
    // Requires run_pcgr_gapfill = true, and an ensemble somatic VCF for every
    // patient (patients without one are excluded, as they are already).
    regenerate_all_pcgr = false
    // null = use each patient's OWN recorded PCGR version (from its GenPipes
    // ini, via the manifest's pcgr_version column). A cohort can legitimately
    // span versions -- MoHQ-HM-19 has both 1.0.3 and 1.4.1 -- and rebuilding a
    // 1.4.1 patient with 1.0.3 would make it stop matching its cohort-mates.
    // Set a value here only to deliberately force one version on everyone.
    pcgr_module         = null
    // Used ONLY for patients whose own PCGR version could not be read from a
    // GenPipes ini (pcgr_version = "unknown"). Everyone else keeps their own.
    // Leave null to make those patients a hard error instead of a silent guess.
    pcgr_module_fallback = null

    // Substitute a DIFFERENT PCGR version for patients whose own recorded
    // version cannot be run.
    //
    // Distinct from pcgr_module_fallback, which handles patients whose version
    // is UNKNOWN. This handles patients whose version is known and unusable:
    // mugqic/pcgr/0.9.2 is installed on Cardinal, loads without error, and
    // provides no `pcgr` executable. Every MoHQ-MU-16 patient recorded against
    // it fails with exit 127, and no fallback applies because their version is
    // not unknown -- it is known and broken.
    //
    // Format: comma-separated from=to pairs.
    //     --pcgr_module_map 'mugqic/pcgr/0.9.2=mugqic/pcgr/1.0.3'
    //
    // This IS a batch variable: those patients are rebuilt with a version they
    // were not originally processed with. It is recorded per patient in
    // mutation_provenance.tsv as pcgr_regenerated_mapped so it can be treated
    // as a covariate, or the patients excluded. Say so in any write-up rather
    // than letting a version substitution pass as equivalence.
    pcgr_module_map = null

    // A directory of PCGR VCFs delivered OUTSIDE the patient folders, named
    // <patient_id>*.vcf.gz. Relative paths resolve inside the cohort
    // directory; absolute paths are used as given.
    //
    // MoHQ-MU-16 ships "20231122_vepvcfs", which holds the ONLY delivered PCGR
    // VCF for 35 of its 102 patients -- including all 32 recorded against
    // mugqic/pcgr/0.9.2, a version installed on Cardinal that provides no
    // executable. Without this those 32 would have to be rebuilt with a
    // different PCGR version, a technical difference affecting a third of the
    // cohort. With it, they use the file the project actually delivered and
    // no substitution is needed.
    //
    // The in-patient copy always wins where both exist; verified identical on
    // MoHQ-MU-16-11 (same VEP run timestamp, same variant count).
    external_pcgr_dir = null
    pcgr_bundle         = '/cvmfs/soft.mugqic/CentOS6/genomes/pcgr/20220203'
    // Loaded alongside pcgr so `tabix` exists for indexing the input VCF.
    // PCGR refuses a bgzipped VCF with no .tbi beside it.
    htslib_module       = 'mugqic/htslib/1.23'
    pcgr_tumor_site     = 0        // --tumor_site 0 = unspecified
    // --assay WGS describes the ASSAY, not the TMB denominator. The delivered
    // runs also pass --tmb_algorithm nonsyn, which counts nonsynonymous coding
    // variants -- so the denominator is the coding space (~30 Mb, see
    // callable_mb), NOT the 2800 Mb genome. An earlier comment here claimed the
    // opposite and would have inflated every TMB by ~90x if believed.
    pcgr_assay          = 'WGS'

    // --- filter_ensemble: the step BETWEEN the ensemble VCF and PCGR -------- //
    // Recovered from the delivered runs' [filter_ensemble] config section and
    // the ##bcftools_viewCommand preserved in the delivered PCGR VCF headers.
    // See modules/local/filter_ensemble.nf for why this is not optional.
    filter_ensemble_min_callers = 2          // [filter_ensemble] call_filter
    filter_ensemble_expr = 'TDP>=10 && TVAF>=0.05 && NDP>=10 && NVAF<=0.05'
                                             // somatic_filter_options, verbatim
    python_module        = 'mugqic/python/3.10.4'      // cyvcf2 for format2pcgr
    mugqic_tools_module  = 'mugqic/mugqic_tools/2.10.5' // provides format2pcgr.py
    bcftools_module      = 'mugqic/bcftools/1.15'
    filtered_vcf_dir     = "${projectDir}/filtered_ensemble"

    // Copied VERBATIM from the delivered runs' [report_pcgr] section
    // (MoHQ-HM-19-1.TumourPair.ini). These are not defaults I chose -- the
    // depth/AF tag names in particular are specific to the GenPipes ensemble
    // VCF, and PCGR would filter incorrectly with anything else.
    //
    // NOTE: the delivered options include --vcf2maf, i.e. PCGR was already
    // asked to write a MAF -- and that is the unannotated MAF you have. So
    // re-running PCGR regenerates the VCF, NOT a usable MAF. The VCF2MAF step
    // remains necessary regardless.
    pcgr_extra_args = '--no_vcf_validate --no_docker --vep_buffer_size 500 ' +
                      '--vep_regulatory --show_noncoding ' +
                      '--call_conf_tag TAL --tumor_dp_tag TDP --tumor_af_tag TVAF ' +
                      '--tumor_dp_min 10 --tumor_af_min 0.05 ' +
                      '--control_dp_tag NDP --control_af_tag NVAF ' +
                      '--control_dp_min 10 --control_af_max 0.05 ' +
                      '--estimate_signatures --estimate_tmb --tmb_algorithm nonsyn ' +
                      '--estimate_msi_status'

    regenerated_pcgr_dir = "${projectDir}/regenerated_pcgr"

    // --- Escape hatches --------------------------------------------------- //
    // Leave null to have the pipeline build the cohort .seg from CNVkit VCFs.
    seg_file        = null
    marker_file     = null

    // --- Toggles ---------------------------------------------------------- //
    run_oncoprint      = true
    run_cnv_frequency  = true
    run_cnv_burden     = true
    run_pca            = true
    run_comparative    = false   // off by default: needs --gtf and metadata
    run_fusions        = true
    run_gistic         = false
    run_report         = true

    // NOTE: the manifest itself is ALWAYS built -- it is the index every later
    // step uses to find files. This toggle only controls the completeness
    // FIGURE, which is cheap (it reads one small table) and worth keeping on.
    run_completeness_plot = true

    // --- Copy-number thresholds ------------------------------------------- //
    // Used by EVERY script. The original had these as params but then also
    // hardcoded +/-0.2 inside two FGA calculations, so the report contained
    // numbers computed at two different thresholds.
    amp_threshold      = 0.58
    del_threshold      = -0.58
    cnv_bin_size       = 1000000
    include_sex_chr    = false
    min_seg_markers    = 0
    min_profiled_mb    = 1000    // flag samples profiled over less than this

    // --- Mutations -------------------------------------------------------- //
    oncoplot_top_genes = 25
    // FLAGS = FrequentLy mutAted GeneS: long, repetitive, segmental-duplication
    // genes that top the recurrence ranking in every cohort because of mapping
    // error, not biology. The first real MoHQ oncoplot had 25 of 25 top genes
    // from this list and no recognisable driver. Excluding them is standard, and
    // it is a judgement -- the unfiltered ranking is still written to disk as
    // <cohort>_oncoprint_gene_rank_unfiltered.tsv.
    exclude_flags      = true
    extra_flags        = ''      // comma-separated extra symbols to exclude
    // ALLOWLIST. A file of HGNC symbols, one per line -- e.g. the COSMIC Cancer
    // Gene Census. Strongly preferred over the blocklist for any figure someone
    // will interpret: a blocklist answers the open-ended "which genes do I not
    // believe?", an allowlist answers the finite, citable "which genes am I
    // making a claim about?".
    // ALLOW-LIST. One HGNC symbol per line, '#' comments allowed. When set,
    // the oncoplot ranks only these genes -- which is the only approach that
    // converges, since a blocklist always has another tier of long genes
    // underneath it. Build one from the collection's own Hartwig driver
    // catalogues with bin/build_gene_panel.sh, or supply COSMIC CGC / OncoKB.
    gene_panel         = null

    // BACKGROUND / CLUSTERING MODEL. Ranks genes by whether their mutations
    // concentrate at particular residues rather than by how many there are, so
    // gene length cancels out. Finds hotspot oncogenes (BRAF V600, NRAS Q61);
    // does NOT find tumour suppressors inactivated by scattered truncating
    // mutations. A complement to the frequency ranking, not a replacement.
    run_oncodrive      = true
    oncodrive_min_mut  = 5
    // TMB DENOMINATOR, in Mb. This must match what the NUMERATOR counts.
    // run_oncoprint.R counts NON-SYNONYMOUS (coding) variants, so the correct
    // denominator is the CODING footprint (~30-40 Mb) even for whole-genome
    // data. Using 2800 here understates TMB by roughly 90x: the first real run
    // gave 0.01-0.05 mut/Mb, where the same variants over 30 Mb give 0.9-4.7.
    // Use ~2800 only if you also count non-coding variants.
    callable_mb        = 30

    // --- Expression ------------------------------------------------------- //
    pca_norm_method    = 'log2'  // log2 | log10 | zscore | none
    pca_top_var_genes  = 2000    // 0 = all genes
    pca_colour_by      = 'institution'

    // --- Comparative ------------------------------------------------------ //
    comparative_group_col   = 'institution'
    comparative_n_genes     = 20
    comparative_min_group_n = 5
    target_genes            = null   // comma-separated; null = data-driven

    // --- Fusions ---------------------------------------------------------- //
    min_fusion_recurrence = 2

    // --- GISTIC ----------------------------------------------------------- //
    // The original set -broad 0 and -armpeel 0, which disables arm-level and
    // broad-event analysis -- most of what GISTIC is for at cohort scale.
    gistic_broad   = 1
    gistic_armpeel = 1
    gistic_conf    = 0.99
    gistic_ta      = 0.1
    gistic_td      = 0.1
    gistic_scent   = 'median'

    // --- Execution -------------------------------------------------------- //
    slurm_account  = null
    container      = null        // path to pipeline.sif
    max_memory     = '250.GB'
    max_cpus       = 32
    max_time       = '48.h'
}

includeConfig 'conf/base.config'

// Exported into every task, so the R annotation guard in mohq_common.R uses the
// same thresholds as the shell guard in VCF2MAF. Both previously hardcoded 50%,
// and both were wrong for whole-genome data.
env {
    MOHQ_MIN_ANNOTATED_GENES = "${params.min_annotated_genes}"
    MOHQ_MAX_UNKNOWN_FRAC    = "${params.max_unknown_frac}"
}

profiles {

    standard { process.executor = 'local' }

    // -----------------------------------------------------------------------
    // Cardinal (SD4H). Configured from the real `check_cardinal.sh` output:
    //   AlmaLinux 9.8, SLURM, account def-c3g,
    //   partitions: cpubase_bycore_b1 (default), cnode-, cnode-hm- (high mem)
    //
    // Everything runs here. Juno is reachable from Cardinal, so harvest and
    // analysis share one machine and nothing is transferred.
    //
    // Before running:  module load apptainer/1.3.5 java/17
    // (neither is on PATH by default; both exist as modules)
    // -----------------------------------------------------------------------
    cardinal {
        process {
            executor       = 'slurm'
            queue          = 'cpubase_bycore_b1'
            clusterOptions = "--account=def-c3g"
            scratch        = true

            // cnode-hm- is the high-memory partition. Route the two tasks whose
            // footprint scales with cohort size there, and leave everything
            // else on the default partition.
            withLabel: process_high_memory { queue = 'cnode-hm-' }
        }
        executor {
            queueSize       = 30
            submitRateLimit = '10/1min'
        }
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('HOME')}/.apptainer_cache"
            // --cleanenv: do not pass the host environment into the container,
            // so a run does not depend on which modules happened to be loaded.
            //
            // NOTE: an earlier version of this comment claimed --cleanenv fixed
            //   python3: symbol lookup error: undefined symbol: XML_SetHashSalt
            // It does not, and that diagnosis was wrong twice over. The bad
            // libexpat is INSIDE the image: GISTIC's MCR v83 bundles a 2012
            // copy, and the old %environment put it first on LD_LIBRARY_PATH
            // for every process. Fixed in pipeline.def by scoping MCR to the
            // GISTIC task alone. Keep --cleanenv for hygiene, not for that.
            // --bind /cvmfs: the image does not see CVMFS otherwise, and several
            // inputs live there -- the PCGR reference bundle, the VEP cache, and
            // the GTF used for gene coordinates and coding lengths. Without it
            // file.exists() is FALSE inside the container and the step reports
            // 'no coding lengths could be read' about a file that is plainly on
            // disk. Bound read-only; skipped automatically if /cvmfs is absent.
            runOptions = '--cleanenv' + (new File('/cvmfs').exists() ? ' --bind /cvmfs:/cvmfs:ro' : '')
        }
    }

    // Same machine, no scheduler: runs everything in the shell you are sitting
    // in. Use this INSIDE an salloc for the first end-to-end test -- failures
    // surface immediately instead of in a SLURM log.
    cardinal_local {
        process.executor = 'local'
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('HOME')}/.apptainer_cache"
            // --bind /cvmfs: the image does not see CVMFS otherwise, and several
            // inputs live there -- the PCGR reference bundle, the VEP cache, and
            // the GTF used for gene coordinates and coding lengths. Without it
            // file.exists() is FALSE inside the container and the step reports
            // 'no coding lengths could be read' about a file that is plainly on
            // disk. Bound read-only; skipped automatically if /cvmfs is absent.
            runOptions = '--cleanenv' + (new File('/cvmfs').exists() ? ' --bind /cvmfs:/cvmfs:ro' : '')
        }
    }

    // Run VCF2MAF on the HOST with modules, instead of inside the VEP image.
    //
    // Valid ONLY with inhibit_vep = true, which this profile therefore sets.
    // With --inhibit-vep, vcf2maf does not run VEP at all: it parses the CSQ
    // field PCGR already wrote into its VCF. So the step needs nothing but
    // perl, samtools and tabix -- all modules on Cardinal.
    //
    // Why bother: vcf2maf hard-requires the samtools AND tabix binaries
    // (vcf2maf.pl lines 295 and 299, both before any VEP branch). The Ensembl
    // VEP image ships neither, so the container route needs `-B /cvmfs` plus
    // --samtools-exec and --tabix-exec pointing inside the container. Running
    // on the host is the setup that already worked on Narval, and it is faster:
    // seconds per patient rather than tens of minutes, with gene symbols that
    // match the PCGR reports exactly instead of being a second opinion.
    //
    // ONLY covers patients with a delivered PCGR VCF. Ensemble-VCF patients
    // have no CSQ field and will fail the guard in the process -- use
    // run_pcgr_gapfill for those.
    //
    //   nextflow run . -profile cardinal,vcf2maf_host -params-file ...
    //
    vcf2maf_host {
        params.inhibit_vep = true
        process {
            withName: VCF2MAF {
                container = null
                // Verify these names resolve on YOUR shell first:
                //   module load mugqic/samtools/1.23 mugqic/htslib/1.23
                module = 'mugqic/samtools/1.23:mugqic/htslib/1.23'

                // With --inhibit-vep there is no VEP run to parallelise:
                // vcf2maf just parses the CSQ field PCGR already wrote, which
                // is single-threaded and quick. The process_vep label asks for
                // 4 CPUs and 16 GB, sized for a real VEP run. Keeping that here
                // wastes an allocation, and under the local executor it fails
                // outright with
                //     Process requirement exceeds available CPUs -- req: 4; avail: 1
                cpus   = 1
                memory = 8.GB
                time   = 1.h
            }
        }
    }

    // No container at all: use Cardinal's own R module instead.
    // Fallback if `apptainer build` cannot reach Docker Hub from inside SD4H,
    // which is a real possibility in a secure environment.
    //   module load r-bundle-bioconductor/3.21
    no_container {
        apptainer.enabled = false
        docker.enabled    = false
        process.container = null
    }

    narval {
        process {
            executor       = 'slurm'
            clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : '' }
            scratch        = true
        }
        executor {
            queueSize          = 50
            submitRateLimit    = '10/1min'
        }
        apptainer {
            enabled    = true
            autoMounts = true
            // Cache outside $HOME: home quotas on Alliance clusters are small
            // and a full cache dir fails jobs in confusing ways.
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/.apptainer_cache"
        }
        params.slurm_account = params.slurm_account ?: 'rrg-bourqueg-ad'
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        docker.enabled = false
    }

    docker {
        docker.enabled = true
        apptainer.enabled = false
    }

    test {
        params.max_memory = '8.GB'
        params.max_cpus   = 2
        params.max_time   = '1.h'
    }

    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME; ls -la'
        cleanup                = false
    }
}

// Container applies to every process unless a module overrides it.
//
// Evaluated as a closure so it can see `workflow.stubRun`, which is only known
// once the run starts. A stub executes no real commands, so requiring the image
// to exist would defeat the purpose of a check you want to run BEFORE the
// environment is complete -- apptainer fails on a missing .sif even when the
// command is just `touch`.
process {
    container = { workflow.stubRun ? null : (params.container ?: 'pipeline.sif') }
}

// --------------------------------------------------------------------------- //
// Provenance. The original produced none, which for a multiyear project means
// you cannot reconstruct how a figure from 18 months ago was made.
// --------------------------------------------------------------------------- //
def trace_ts = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }

// Fail fast on typos like `params.cohort_nmae`.
nextflow.enable.strict = true
